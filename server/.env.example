PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

DATABASE_HOST=aws-0-ap-northeast-1.pooler.supabase.com
DATABASE_PORT=database_port
DATABASE_DATABASE=database_name
DATABASE_USER=database_user
DATABASE_PASSWORD=database_password
DATABASE_URL=postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_DATABASE}

# Opaque session auth (no JWT access/refresh pair)
SESSION_TTL_DAYS=14
SESSION_ABSOLUTE_DAYS=30
SESSION_SLIDING=true
SESSION_SLIDING_REMAINING_DAYS=7

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_INVENTORY_MAX=200
RATE_LIMIT_BRANCH_MAX=150
RATE_LIMIT_SYNC_MAX=400
RATE_LIMIT_ADMIN_MAX=150
RATE_LIMIT_NOTIFICATIONS_MAX=120

# Optional Redis (rate-limit store + login lockout). Falls back to memory when unset.
REDIS_URL=redis://127.0.0.1:6379

# Login lockout after failed attempts (per loginId + IP). Locked users cannot login even with correct password.
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_WINDOW_MS=900000
AUTH_LOCKOUT_DURATION_MS=360000

# Optional Twilio SMS (logs to console when unset)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional SMTP (logs credentials to console when unset — create/reset still succeed)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=